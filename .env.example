# Optional: OpenAI embeddings + LLM rerank / comment drafting.
OPENAI_API_KEY=

DATABASE_URL=sqlite:///./relaygrid.db
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Set true in production so posts/comments require X-API-Key.
REQUIRE_API_KEY=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

ROUTING_TOP_K=50
ROUTING_FINAL_LIMIT=5
ROUTING_RERANK_THRESHOLD=0.55
EMBEDDING_DIM=384
